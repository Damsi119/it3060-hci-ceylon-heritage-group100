{
  "info": {
    "_postman_id": "c4e1a19a-0f2a-4b79-a388-b6cc3b1f11ac",
    "name": "Ceylon Heritage - Places and Weather",
    "description": "Read-only requests for the implemented nearby places, recommendations, search, and weather APIs. Set baseUrl to the running Spring Boot backend (default http://localhost:8081).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "latitude", "value": "6.0535" },
    { "key": "longitude", "value": "80.2210" },
    { "key": "radiusKm", "value": "10" }
  ],
  "item": [
    {
      "name": "Places",
      "item": [
        { "name": "List all places", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/places" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Response is JSON', () => pm.response.to.be.json);"] } }] },
        { "name": "Recommended places", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/places/recommended" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Response is JSON', () => pm.response.to.be.json);"] } }] },
        { "name": "Search places - Galle", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/places/search?keyword=Galle&category=ALL" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Response is JSON', () => pm.response.to.be.json);"] } }] },
        { "name": "Nearby places - Galle", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/places/nearby?latitude={{latitude}}&longitude={{longitude}}&radiusKm={{radiusKm}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Response is JSON', () => pm.response.to.be.json);"] } }] }
      ]
    },
    {
      "name": "Weather",
      "item": [
        { "name": "Galle weather forecast", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/weather?location=Galle" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Response is JSON', () => pm.response.to.be.json);"] } }] }
      ]
    }
  ]
}
